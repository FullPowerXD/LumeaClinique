# ---------------------------------------------------------------------------
# LUMEA CLINIQUE - environment variables
# Copy this file to `.env.local` and adjust the values for each environment.
# ---------------------------------------------------------------------------

# Public base URL of the site. Used for metadata, canonical URLs, sitemap and
# Open Graph tags. No trailing slash.
# Used by src/data/site.ts
NEXT_PUBLIC_SITE_URL=https://www.lumea-clinique.com

# ---------------------------------------------------------------------------
# Planned integrations - not wired yet, safe to leave empty.
# The three forms (appointment, contact, VIP) currently simulate a submission
# on the client side. The variables below are the ones a backend will need.
# ---------------------------------------------------------------------------

# Google Maps embed / geocoding key (optional).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# E-mail addresses used by the contact and VIP forms.
# NEXT_PUBLIC_CONTACT_EMAIL=bonjour@lumea-clinique.com
# NEXT_PUBLIC_VIP_EMAIL=vip@lumea-clinique.com

# Secret key of the transactional e-mail provider (Resend / Postmark / SES).
# RESEND_API_KEY=

# Address the e-mails are sent from.
# CONTACT_FROM_EMAIL=bonjour@lumea-clinique.com
